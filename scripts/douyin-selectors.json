{
  "version": 1,
  "updated": "2026-10-28",
  "notes": "抖音网页版直播（live.douyin.com）弹幕 DOM 选择器。抖音前端是 React SSR + 客户端水合，class 名带 hash 且会随版本变化（例如 webcast-chatroom___item）。改版后只需改这个文件：把聊天区容器/单条消息/用户名/正文/礼物元素的选择器按上面的 CSS 优先级数组从新到旧排列；文本型标记（followText/likeText/enterText/endedText）按页面实际文案填写；giftValues 用来把礼物名映射成价值（拿不到价格时填 0）。",
  "desktopUrl": "https://live.douyin.com/",
  "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36",
  "chatRoot": [
    "div[class*=\"webcast-chatroom___items\"]",
    "div[class*=\"webcast-chatroom___list\"]",
    ".webcast-chatroom",
    "div[class*=\"ChatRoom\"]",
    "div[class*=\"chatroom\"]",
    "[data-e2e=\"chatroom\"]",
    "[data-e2e=\"chat-room\"]",
    "div[class*=\"chat-list\"]",
    "div[class*=\"chat_list\"]"
  ],
  "item": [
    "div[class*=\"webcast-chatroom___item\"]",
    "div[class*=\"chatroom___item\"]",
    "[data-e2e=\"chat-item\"]",
    "li[class*=\"chatroom\"]",
    "div[class*=\"chat-item\"]"
  ],
  "user": [
    "span[class*=\"webcast-chatroom___nickname\"]",
    "[class*=\"webcast-chatroom___nickname\"]",
    "span[class*=\"webcast-chatroom___user-name\"]",
    "[class*=\"webcast-chatroom___user-name\"]",
    "[class*=\"webcast-chatroom___author\"]",
    "[data-e2e=\"chat-author\"]",
    "[class*=\"user-name\"]",
    "[class*=\"nickname\"]",
    "[class*=\"author\"]"
  ],
  "text": [
    "span[class*=\"webcast-chatroom___content-with-emoji\"]",
    "[class*=\"webcast-chatroom___content\"]",
    "[data-e2e=\"chat-content\"]",
    "[class*=\"content-with-emoji\"]",
    "[class*=\"chat-content\"]"
  ],
  "giftItem": [
    "div[class*=\"webcast-chatroom___gift\"]",
    "[class*=\"gift-message\"]",
    "[data-e2e=\"gift-item\"]"
  ],
  "giftName": [
    "[class*=\"webcast-chatroom___gift-name\"]",
    "[class*=\"gift-name\"]",
    "[class*=\"giftName\"]",
    "[class*=\"gift-title\"]"
  ],
  "giftCount": [
    "[class*=\"webcast-chatroom___gift-count\"]",
    "[class*=\"gift-count\"]",
    "[class*=\"giftCount\"]",
    "[class*=\"gift-num\"]"
  ],
  "followText": ["关注了主播", "关注了直播间", "关注了你"],
  "likeText": ["为主播点赞了", "点赞了主播", "点赞了"],
  "enterText": ["来了", "加入了直播间", "进入了直播间", "进入直播间"],
  "endedText": ["直播已结束", "直播结束", "主播不在线", "暂未开播", "直播间已关闭"],
  "blockedText": ["请完成安全验证", "验证码", "拖动滑块", "访问过于频繁"],
  "giftValues": {
    "小心心": 1,
    "玫瑰": 1,
    "大啤酒": 2,
    "甜甜圈": 5,
    "棒棒糖": 9,
    "小汽车": 10,
    "跑车": 20,
    "飞机": 100,
    "火箭": 100,
    "嘉年华": 30000,
    "爱你哟": 1,
    "粉丝团灯牌": 1,
    "点赞": 1,
    "鼓掌": 1
  },
  "notesCompatibility": "item 兜底：当 item 选择器全部失效时，采集器会把聊天根容器的直接子元素当作一条消息解析，因此通常只需修 chatRoot+item 两条就能恢复。"
}
