# =============================================================================
# 大肥鱼直播 · 环境变量模板（这是示例文件，可以提交到 git）
# -----------------------------------------------------------------------------
# 用法：把本文件复制为同目录下的 .env，再填写真实值。
#   PowerShell:  Copy-Item .env.example .env
#   cmd:         copy .env.example .env
# .env 已被 .gitignore 忽略（.env / .env.*），不会进入版本库，也不会被打包。
#
# 查找优先级（逐键判断，空值视为“未设置”，自动回退下一层）：
#   1. 进程环境变量      例：$env:LLM_API_KEY="sk-..."
#   2. 仓库根目录 .env   ← 通常改这里
#   3. userData/.env     Electron: %APPDATA%\dyzb\.env；纯 Node 调试时同仓库根
#
# 重要：
#   · .env 的值只覆盖“运行时内存配置”，绝不写回 data/config.json；
#   · 想永久改某项又不想用 .env，就在控制台/配置里改，别写进 .env；
#   · 修改 .env 后需要重启服务（npm start / npm run server）才生效。
# =============================================================================

# ---- LLM（OpenAI 兼容接口，默认 DeepSeek） ---------------------------------
# API 密钥。填了它 = LLM 模式；留空且 config.json 也没有 Key = Echo 模式（内置台词）。
# 这是密钥，只写在这里或进程环境变量里，绝不要填进控制台配置面板。
# 示例：LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_KEY=

# 接口地址（要带 /v1），默认 https://api.deepseek.com/v1
# LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名，默认 deepseek-chat
# LLM_MODEL=deepseek-chat

# 采样温度 0 ~ 2，默认 0.95（越小越稳，越大越发散）
# LLM_TEMPERATURE=0.95

# 单次回复的最大 token，默认 120（夜间自动降为 60）
# LLM_MAX_TOKENS=120

# ---- TTS 语音 ---------------------------------------------------------------
# 提供方：edge（默认，微软 Edge 在线语音，免费）/ openai / none（不发声）
# TTS_PROVIDER=edge

# 音色。Edge 中文女声默认 zh-CN-XiaoxiaoNeural，另有 zh-CN-XiaoyiNeural 等
# TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---- 外部弹幕接入 -----------------------------------------------------------
# POST /ingest 与 ws://…/ingest 共用 token（请求头 x-ingest-token 或 ?token=）。
# 默认 change-me 属于公开值，务必改成随机长字符串，并让采集端保持一致。
# INGEST_TOKEN=change-me

# ---- 在线背景音乐 -----------------------------------------------------------
# Jamendo 免费 client_id（https://developer.jamendo.com/v3.0，注册后创建 app 即可拿到）。
# 不填也能用：会自动只用 Internet Archive 公版/CC 曲库。
# JAMENDO_CLIENT_ID=
#
# 曲库开关在控制台配置 jukebox.provider：auto（默认）/ local / jamendo / archive；
# jukebox.commercialOnly=true 时只返回 CC BY / BY-SA / CC0 / 公版曲目。
# 在线曲目播放前会缓存到 data/music-cache/（上限 jukebox.maxCacheMb）。

# ---- 本地服务端口 -----------------------------------------------------------
# 覆盖 server.port；设置后优先于控制台配置，改端口需要重启服务（默认 17890）。
# 端口被占用时可用：node scripts/dev-server.js --port 18090（命令行优先于本文件）。
# SERVER_PORT=17890

# ---- 说明 -------------------------------------------------------------------
# 抖音采集（douyin.enabled / roomId / browserPath / headless / restartDelaySec）
# 只支持在 data/config.json 或控制台里配置，不通过环境变量提供。
